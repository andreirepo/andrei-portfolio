{
  "name": "andrei-portfolio",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro-i18n-check --base en && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check-sync": "astro-i18n-check --base en",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "vitest --run src/tests/e2e",
    "test:a11y": "vitest --run src/tests/accessibility-contrast-bug-condition.test.ts src/tests/accessibility-full-audit.test.ts"
  },
  "dependencies": {
    "@ariaskit/astro-i18n": "^0.0.8",
    "@astrojs/sitemap": "^3.7.0",
    "@lucide/astro": "^0.563.0",
    "@tailwindcss/vite": "~4.1.18",
    "astro": "^5.17.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "~4.1.18"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@types/node": "^25.2.0",
    "@vitest/ui": "^4.1.5",
    "axe-playwright": "^2.2.2",
    "fast-check": "^4.7.0",
    "playwright": "^1.59.1",
    "vitest": "^4.1.5"
  }
}
