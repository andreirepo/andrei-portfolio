
---
import I18NDebug from "@ariaskit/astro-i18n/I18NDebug.astro";

interface Props {
    name: string;
    title: { key: string; value: string };
    p1: { key: string; value: string };
    p2: { key: string; value: string };
    p3: { key: string; value: string };
    stack?: string[];
    certs?: string[];
}

const { name, title, p1, p2, p3, stack = [], certs = [] } = Astro.props as Props;
---

<section data-testid="hero-section" id={name} class="min-h-[100dvh] flex flex-col justify-center mt-8 mb-16 relative">
    <div class="hero-shapes pointer-events-none fixed inset-0" aria-hidden="true">
        <div class="hero-shape hero-shape-1"></div>
        <div class="hero-shape hero-shape-2"></div>
        <div class="hero-shape hero-shape-3"></div>
    </div>
    <div class="relative">
        <div id="hero-glow" class="absolute -inset-32 blur-3xl pointer-events-none opacity-0 transition-opacity duration-500" aria-hidden="true" />
        <h1
            data-testid="hero-heading"
            id="hero-heading"
            class="relative mb-6 md:mb-10 font-serif font-medium text-[2.75rem] md:text-[4.25rem] lg:text-[5rem] leading-[1] tracking-tight hero-animate text-foreground"
        >
            {name}
        </h1>
    </div>
    <div class="[&_p]:mb-4 leading-snug">
        <p class="hero-animate-delay-1">
            <I18NDebug key={title.key}>
                <span class="text-foreground/70">{title.value} </span>
            </I18NDebug>
            <I18NDebug key={p1.key}>
                <span class="text-foreground/60">{p1.value}</span>
            </I18NDebug>
        </p>
        <I18NDebug key={p2.key}>
            <p class="text-foreground/60 hero-animate-delay-2">{p2.value}</p>
        </I18NDebug>
        <I18NDebug key={p3.key}>
            <p class="text-foreground/60 hero-animate-delay-3">{p3.value}</p>
        </I18NDebug>
    </div>
    {
        stack.length > 0 && (
            <div class="flex flex-wrap justify-center gap-2 mt-8 hero-animate-delay-4">
                {stack.map((tech) => (
                    <span class="inline-flex items-center px-3 py-1 text-xs font-mono border border-border/60 text-muted-foreground rounded-full">
                        {tech}
                    </span>
                ))}
            </div>
        )
    }
    {
        certs.length > 0 && (
            <div class="flex flex-wrap justify-center gap-2 mt-3 hero-animate-delay-4">
                {certs.map((cert) => (
                    <span class="inline-flex items-center px-3 py-1 text-xs font-mono border border-border/60 text-muted-foreground rounded-full">
                        {cert}
                    </span>
                ))}
            </div>
        )
    }
</section>

<script>
    (function () {
        var heading = document.getElementById('hero-heading');
        var glow = document.getElementById('hero-glow');
        if (!heading || !glow) return;
        var isHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
        if (!isHover) return;
        var ticking = false;
        function update(e) {
            var rect = heading.getBoundingClientRect();
            var x = e.clientX - rect.left;
            var y = e.clientY - rect.top;
            glow.style.background = 'radial-gradient(circle at ' + x + 'px ' + y + 'px, color-mix(in oklch, var(--foreground) 10%, transparent) 0%, transparent 50%)';
        }
        function onMove(e) {
            glow.classList.remove('opacity-0');
            glow.classList.add('opacity-100');
            if (!ticking) {
                requestAnimationFrame(function () { update(e); ticking = false; });
                ticking = true;
            }
        }
        heading.addEventListener('mousemove', onMove);
        heading.addEventListener('mouseleave', function () {
            glow.classList.remove('opacity-100');
            glow.classList.add('opacity-0');
        });
    })();
</script>
