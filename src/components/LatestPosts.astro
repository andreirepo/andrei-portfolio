---
import { getCollection } from "astro:content";
import BlogCard from "@/src/components/BlogCard.astro";

interface Props {
  lang: string;
  title: string;
  seeAllLabel: string;
  seeAllHref: string;
  publishedLabel: string;
  limit?: number;
}

const {
  lang,
  title,
  seeAllLabel,
  seeAllHref,
  publishedLabel,
  limit = 2,
} = Astro.props as Props;

let posts = await getCollection("blog", ({ id, data }) =>
  id.startsWith(`${lang}/`) && !data.draft
);

if (posts.length === 0 && lang !== "en") {
  posts = await getCollection("blog", ({ id, data }) =>
    id.startsWith("en/") && !data.draft
  );
}

posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latest = posts.slice(0, limit);
---

{latest.length > 0 && (
  <section class="scroll-mt-50">
    <div class="flex items-center justify-between mb-6 mt-15">
      <h2 class="opacity-50 uppercase">{title}</h2>
      <a
        href={seeAllHref}
        class="text-xs opacity-50 hover:opacity-100 hover:text-green-500 transition-all duration-200"
      >
        {seeAllLabel} →
      </a>
    </div>

    <ul class="space-y-3">
      {latest.map((post) => {
        const slug = post.id.replace(/^(en|es)\//, "").replace(/\.md$/, "");
        return (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            slug={slug}
            lang={lang}
            publishedLabel={publishedLabel}
          />
        );
      })}
    </ul>
  </section>
)}
