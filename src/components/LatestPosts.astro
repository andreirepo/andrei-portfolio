---
import { getCollection } from "astro:content";
import BlogCard from "@/src/components/BlogCard.astro";

interface Props {
  lang: string;
  title: string;
  seeAllLabel: string;
  seeAllHref: string;
  limit?: number;
}

const {
  lang,
  title,
  seeAllLabel,
  seeAllHref,
  limit = 2,
} = Astro.props as Props;

let posts = await getCollection("blog", ({ id, data }) =>
  id.startsWith(`${lang}/`) && !data.draft
);

if (posts.length === 0 && lang !== "en") {
  posts = await getCollection("blog", ({ id, data }) =>
    id.startsWith("en/") && !data.draft
  );
}

posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latest = posts.slice(0, limit);
---

{latest.length > 0 && (
  <section data-testid="latest-posts-section" id="blog" class="scroll-mt-24 mt-16 section-fade-in">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-amber-accent font-serif font-medium tracking-tight text-[1.75rem] md:text-[2rem]">{title}</h2>
      <a
        data-testid="see-all-posts-link"
        href={seeAllHref}
        class="text-xs text-amber-accent hover:text-foreground transition-colors"
      >
        {seeAllLabel} →
      </a>
    </div>

    <ul class="space-y-1">
       {latest.map((post) => {
        const slug = post.id.replace(/^(en|es)\//, "").replace(/\.md$/, "");
        return (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            slug={slug}
            lang={lang}
          />
        );
      })}
    </ul>
  </section>
)}
