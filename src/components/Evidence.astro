---
interface Stat {
    value: string;
    label: string;
}

interface Props {
    title: string;
    lead: string;
    stats: Stat[];
    image: string;
    alt: string;
    caption: string;
}

const { title, lead, stats, image, alt, caption } = Astro.props as Props;
---

<section id="evidencia" data-testid="evidence-section" class="scroll-mt-24 mt-12 md:mt-16 section-fade-in">
    <div class="section-head">
        <h2>{title}</h2>
    </div>

    <p class="text-foreground/70 text-body leading-relaxed max-w-[62ch]">{lead}</p>

    <ul data-testid="evidence-stats" class="evidence-stats">
        {
            stats.map((stat) => (
                <li>
                    <span class="evidence-value">{stat.value}</span>
                    <span class="evidence-label">{stat.label}</span>
                </li>
            ))
        }
    </ul>

    <figure class="mt-6">
        <img
            src={image}
            alt={alt}
            width="900"
            height="823"
            loading="lazy"
            decoding="async"
            class="w-full rounded-lg border border-border/60"
        />
        <figcaption class="mt-2 text-xs text-muted-foreground">{caption}</figcaption>
    </figure>
</section>
