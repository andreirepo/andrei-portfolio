---
type Option = { key: string; value: string | number };

interface Content {
    title: Option;
    category: Option;
    description: Option;
    experience_years: Option;
    experience_label: Option;
}

interface Props {
    heading: Option;
    content: Content[];
}

const { heading, content } = Astro.props as Props;
---

<section data-testid="skills-section" id="skills" class="scroll-mt-50">
    <h2 class="text-muted-foreground uppercase mb-6 mt-15 text-heading-m">{heading.value}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {
            content.map((skill) => (
                <article data-testid="skill-card" class="border p-4">
                    <p class="text-green-accent font-semibold mb-1">
                        {">"}{skill.title.value}
                    </p>
                    <p class="text-muted-foreground uppercase mb-3 text-muted">{skill.category.value}</p>
                    <p class="text-body text-muted-foreground pb-3 border-b mb-3">{skill.description.value}</p>
                    <div class="flex gap-2 items-center">
                        <span class="font-semibold text-heading-l">{skill.experience_years.value}</span>
                        <span class="text-muted-foreground text-heading-m">{skill.experience_label.value}</span>
                    </div>
                </article>
            ))
        }
    </div>
</section>
