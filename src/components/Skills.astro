---
type Option = { key: string; value: string | number };

interface Content {
    title: Option;
    category: Option;
    description: Option;
    experience_years: Option;
    experience_label: Option;
}

interface Props {
    heading: Option;
    content: Content[];
}

const { heading, content } = Astro.props as Props;
---

<section data-testid="skills-section" id="skills" class="scroll-mt-24 section-fade-in">
    <h2 class="text-amber-accent font-bold uppercase tracking-tight mb-6 mt-12 text-heading-m">{heading.value}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {
            content.map((skill) => (
                <article data-testid="skill-card" class="border rounded-lg p-4 transition-all duration-200 hover:border-amber-accent hover:bg-muted/30 group">
                    <p class="text-amber-accent font-semibold mb-1 group-hover:text-amber-accent transition-colors duration-200">
                        {">"}{skill.title.value}
                    </p>
                    <p class="text-muted-foreground uppercase mb-3 text-xs tracking-wide">{skill.category.value}</p>
                    <p class="text-sm text-muted-foreground pb-3 border-b mb-3 leading-relaxed">{skill.description.value}</p>
                    <div class="flex gap-2 items-baseline">
                        <span class="font-semibold text-2xl text-foreground">{skill.experience_years.value}</span>
                        <span class="text-muted-foreground text-sm">{skill.experience_label.value}</span>
                    </div>
                </article>
            ))
        }
    </div>
</section>
