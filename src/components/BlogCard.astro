---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  slug: string;
  lang: string;
  activeTag?: string;
}

const { title, description, pubDate, tags, slug, lang, activeTag } = Astro.props as Props;

const formattedDate = pubDate.toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const href = `/${lang}/blog/${slug}`;
---

<li class="group border border-transparent rounded-lg transition-all duration-200 hover:border-amber-accent/30 hover:bg-muted/20">
    <div class="flex flex-col justify-start p-6">
        <a href={href} class="block">
            <p class="text-lg font-serif font-medium text-foreground group-hover:text-amber-accent transition-colors duration-200 leading-relaxed mb-3">{title.trim()}</p>
            <p class="text-foreground/60 text-sm line-clamp-3 mb-4">{description.trim()}</p>
        </a>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mt-3 text-xs text-muted-foreground/80">
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
          {tags.length > 0 && (
            <span class="text-muted-foreground/40">·</span>
          )}
          {tags.map((tag) => (
            <a
              href={tag === activeTag ? `/${lang}/blog` : `/${lang}/blog/tag/${tag}`}
              onclick="event.stopPropagation()"
              class:list={[
                "border rounded px-1.5 py-0.25 transition-colors duration-200",
                tag === activeTag
                  ? "border-amber-accent text-amber-accent"
                  : "border-border hover:border-amber-accent hover:text-amber-accent"
              ]}
              aria-label={tag === activeTag ? `Clear filter: ${tag}` : `Filter by ${tag}`}
            >
              #{tag}
            </a>
          ))}
        </div>
    </div>
</li>