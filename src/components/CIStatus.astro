---
interface Props {
    repo: string;
    workflow: string;
}

const { repo, workflow } = Astro.props as Props;
const actionsUrl = `https://github.com/${repo}/actions/workflows/${workflow}`;
const badgeUrl = `${actionsUrl}/badge.svg`;
---

<a
    href={actionsUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-2 border rounded px-3 py-1.5 text-xs text-muted-foreground hover:border-amber-accent hover:text-amber-accent hover:bg-amber-accent/10 transition-all duration-200 active:scale-[0.97]"
    data-testid="ci-status-badge"
>
    <img
        src={badgeUrl}
        alt="CI/CD status"
        class="h-4"
        loading="lazy"
        width="86"
        height="16"
    />
    <span>pipeline</span>
</a>
