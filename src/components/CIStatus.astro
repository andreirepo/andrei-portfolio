---
interface Props {
    repo: string;
    workflow: string;
}

const { repo, workflow } = Astro.props as Props;
const actionsUrl = `https://github.com/${repo}/actions/workflows/${workflow}`;
const apiUrl = `https://api.github.com/repos/${repo}/actions/workflows/${workflow}/runs?per_page=1`;
---

<a
    href={actionsUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-2 border rounded px-3 py-1.5 text-xs font-mono text-muted-foreground hover:border-amber-accent hover:text-amber-accent hover:bg-amber-accent/10 transition-all duration-200 active:scale-[0.97]"
    data-testid="ci-status-badge"
    aria-label="CI pipeline: loading"
    aria-busy="true"
>
    <span class="ci-status-ping absolute inline-flex h-full w-full rounded-full animate-ping bg-muted-foreground/40"></span>
    <span class="ci-status-dot relative inline-flex rounded-full h-2 w-2 bg-muted-foreground"></span>
    <span class="ci-status-text">ci ·</span>
    <span class="ci-status-label text-muted-foreground/60">loading…</span>
</a>

<script define:vars={{ apiUrl, actionsUrl }}>
    (function () {
        const CACHE_KEY = "ci-status-andreirepo/andrei-portfolio";
        const CACHE_TTL = 3600000; // 1 hour

        const badge = document.querySelector('[data-testid="ci-status-badge"]');
        if (!badge) return;

        const dot = badge.querySelector('.ci-status-dot');
        const ping = badge.querySelector('.ci-status-ping');
        const label = badge.querySelector('.ci-status-label');
        if (!dot || !ping || !label) return;

        function setStatus(colorClass, text) {
            dot.className = `ci-status-dot relative inline-flex rounded-full h-2 w-2 ${colorClass}`;
            ping.className = 'ci-status-ping absolute inline-flex h-full w-full rounded-full bg-transparent';
            label.textContent = text;
            badge.setAttribute('aria-busy', 'false');
            badge.setAttribute('aria-label', `CI pipeline: ${text}`);
        }

        function renderStatus(data) {
            const run = data.workflow_runs[0];
            const { status, conclusion, created_at } = run;
            const diffMs = Date.now() - new Date(created_at).getTime();
            const diffMin = Math.floor(diffMs / 60000);
            const diffHr = Math.floor(diffMin / 60);
            const diffDay = Math.floor(diffHr / 24);

            let timeAgo;
            if (diffDay > 0) timeAgo = `${diffDay}d ago`;
            else if (diffHr > 0) timeAgo = `${diffHr}h ago`;
            else if (diffMin > 0) timeAgo = `${diffMin}m ago`;
            else timeAgo = 'just now';

            if (status === 'in_progress') {
                setStatus('bg-amber-accent', `running · ${timeAgo}`);
                ping.className = 'ci-status-ping absolute inline-flex h-full w-full rounded-full animate-ping bg-amber-accent/40';
            } else if (conclusion === 'success') {
                setStatus('bg-emerald-500', `passed · ${timeAgo}`);
            } else if (conclusion === 'failure') {
                setStatus('bg-red-500', `failed · ${timeAgo}`);
            } else {
                setStatus('bg-muted-foreground', conclusion || status);
            }
        }

        function showUnknown() {
            setStatus('bg-muted-foreground', 'unknown');
        }

        function fetchAndRender() {
            return fetch(apiUrl)
                .then((res) => {
                    if (!res.ok) throw new Error(`API ${res.status}`);
                    return res.json();
                })
                .then((data) => {
                    if (!data.workflow_runs?.length) return null;
                    try {
                        localStorage.setItem(CACHE_KEY, JSON.stringify({ ts: Date.now(), data }));
                    } catch (_) {}
                    return data;
                });
        }

        // Try cache first
        let cached = null;
        try {
            const raw = localStorage.getItem(CACHE_KEY);
            if (raw) {
                cached = JSON.parse(raw);
                if (Date.now() - cached.ts > CACHE_TTL) cached = null;
            }
        } catch (_) {}

        if (cached?.data) {
            renderStatus(cached.data);
            if (Date.now() - cached.ts > CACHE_TTL / 2) {
                fetchAndRender().then((d) => { if (d) renderStatus(d); });
            }
        } else {
            fetchAndRender()
                .then((d) => { if (d) renderStatus(d); else showUnknown(); })
                .catch(() => { showUnknown(); });
        }
    })();
</script>
