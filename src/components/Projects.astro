---
import Arrow from "@lucide/astro/icons/corner-right-up";

type Item = {
    name: string;
    description: string;
    link?: string;
    demo?: string;
};

interface Props {
    title: { key: string; value: string };
    projects: Item[];
}

const { title, projects } = Astro.props as Props;
---

<section id={title.value.toLowerCase()} class="scroll-mt-50">
    <h2 class="opacity-50 uppercase mb-6">{title.value}</h2>

    <ul class="space-y-3">
        {
            projects.map((project) => (
                <li class="group">
                    <div class="flex items-center gap-3 mb-1">
                        <span class="font-semibold">{project.name}</span>
                        <Arrow class="h-3 w-3 text-green-500 opacity-50 group-hover:opacity-100 transition-opacity duration-200" />
                    </div>
                    <div class="flex gap-3 mb-2 text-[0.8rem]">
                        {project.link && (
                            <a
                                href={project.link}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-green-500 hover:underline"
                            >
                                GitHub
                            </a>
                        )}
                        {project.demo && (
                            <a
                                href={project.demo}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-green-500 hover:underline"
                            >
                                Live Demo
                            </a>
                        )}
                    </div>
                    <p class="opacity-50 text-[0.88rem]">
                        {project.description}
                    </p>
                </li>
            ))
        }
    </ul>
</section>
