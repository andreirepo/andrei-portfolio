---
type Item = {
    name: string;
    description: string;
    link?: string;
    demo?: string;
};

interface Props {
    title: { key: string; value: string };
    projects: Item[];
}

const { title, projects } = Astro.props as Props;
---

<section id={title.value.toLowerCase()} class="scroll-mt-24 mt-16 section-fade-in">
    <h2 class="text-amber-accent font-serif font-medium tracking-tight mb-8 text-[1.75rem] md:text-[2rem]">{title.value}</h2>

    <ul class="space-y-10">
        {
            projects.map((project) => (
                <li class="group">
                    <span class="font-serif font-medium text-lg">{project.name}</span>
                    <div class="flex gap-3 mt-3 mb-3 text-muted-foreground">
                        {project.link && (
                            <a
                                href={project.link}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-xs text-amber-accent hover:text-foreground transition-colors"
                            >
                                GitHub
                            </a>
                        )}
                        {project.demo && (
                            <a
                                href={project.demo}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-xs text-amber-accent hover:text-foreground transition-colors"
                            >
                                Live Demo
                            </a>
                        )}
                    </div>
                    <p class="text-foreground/60 text-body leading-relaxed">
                        {project.description}
                    </p>
                </li>
            ))
        }
    </ul>
</section>
