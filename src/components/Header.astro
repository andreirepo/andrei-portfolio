---
import I18NDebug from "@ariaskit/astro-i18n/I18NDebug.astro";
import { cls } from "@/src/lib/utils";

type Locales = "es" | "en"

interface Props {
    nav:{path:string;text:string}[];
    locales: Locales[];
    currentLocale:string;
    resumeLabel?: string;
    name?: string;
    homeLabel?: string;
    currentPath?: string;
}

const { nav, locales, currentLocale, resumeLabel = "Resume", name, homeLabel = "home", currentPath = "" } = Astro.props as Props

const RESUME_VERSION = "1";

function resolveHref(path: string): string {
    return path.startsWith('/') ? path : `/${currentLocale}/${path}`;
}

function isActive(path: string): boolean {
    const href = resolveHref(path);
    if (href.includes('#')) return false;
    return currentPath.startsWith(href);
}
---

<header data-testid="site-header" class="py-3 md:py-5 fixed top-0 left-0 right-0 bg-header-gradient backdrop-blur-xl backdrop-saturate-150 z-40 w-full max-w-[100vw] border-b border-border/40 shadow-[0_8px_32px_-8px_rgba(0,0,0,0.12)] transition-shadow duration-300">
  <div class="w-full max-w-2xl mx-auto px-5 md:px-0">

    <!-- Single row: name left | nav center | controls right (desktop) -->
    <!-- Single row: name left | controls+hamburger right (mobile) -->
    <div class="flex items-center justify-between">

      <!-- Left: Resume button (replaces site name) -->
      <a
        data-testid="resume-button"
        href={`/assets/AndreiRepoResume.pdf?v=${RESUME_VERSION}`}
        target="_blank"
        rel="noopener noreferrer"
        onclick="umami.track('Resume Download')"
        class="text-sm transition-all duration-200 rounded px-3 h-7 flex items-center border border-amber-accent/50 text-amber-accent hover:bg-amber-accent/10 hover:scale-[1.03] active:scale-[0.97] shrink-0"
      >
        {resumeLabel}
      </a>

      <!-- Center: nav links (desktop only) -->
      <nav data-testid="main-nav" class="hidden md:flex items-center gap-x-1 flex-1 justify-center" aria-label="Main navigation">
        {name && (
          <a
            data-testid="nav-home"
            href={`/${currentLocale}`}
            class="relative transition-all duration-200 text-sm whitespace-nowrap px-2 py-0.5 rounded active:scale-[0.97] text-muted-foreground hover:text-foreground after:absolute after:bottom-0 after:left-0 after:right-0 after:h-px after:bg-amber-accent after:scale-x-0 after:origin-left after:transition-transform after:duration-200 hover:after:scale-x-100"
          >
            {homeLabel}
          </a>
        )}
        {nav.map((item) => (
          <I18NDebug key={item.text}>
            <a
              data-testid={`nav-${item.text.toLowerCase()}`}
              class={cls(
                "relative transition-all duration-200 text-sm whitespace-nowrap px-2 py-0.5 rounded active:scale-[0.97]",
                "after:absolute after:bottom-0 after:left-0 after:right-0 after:h-px after:bg-amber-accent after:transition-transform after:duration-200 after:origin-left",
                isActive(item.path)
                  ? "text-foreground after:scale-x-100"
                  : "text-muted-foreground hover:text-foreground after:scale-x-0 hover:after:scale-x-100"
              )}
              href={resolveHref(item.path)}
              aria-current={isActive(item.path) ? "page" : undefined}
            >
              {item.text}
            </a>
          </I18NDebug>
        ))}
      </nav>

      <!-- Right: controls -->
      <div class="flex items-center gap-2 shrink-0">

        <!-- Theme toggle -->
        <button
          id="theme-toggle"
          data-testid="theme-toggle"
          aria-label="Toggle appearance"
          class="text-muted-foreground hover:text-foreground hover:bg-foreground/8 transition-all duration-200 flex items-center justify-center w-7 h-7 rounded"
        >
          <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
          </svg>
          <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>

        <!-- Locale switcher -->
        <div data-testid="locale-switcher" class="flex items-center gap-0.5">
          {locales.map(item =>
            <a
              data-testid={`locale-${item.toLowerCase()}`}
              href={`/${item.toLowerCase()}`}
              class={cls("uppercase text-sm cursor-pointer transition-all duration-200 px-1 py-0.5 rounded hover:bg-foreground/8", item === currentLocale.toLowerCase() ? "text-foreground" : "text-muted-foreground hover:text-foreground")}
            >
              {item}
            </a>
            <span class="last:hidden text-muted-foreground text-sm">/</span>
          )}
        </div>

        <!-- Hamburger (mobile only) -->
        <button
          id="menu-toggle"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="md:hidden flex items-center justify-center w-7 h-7 rounded text-muted-foreground hover:text-foreground hover:bg-foreground/8 transition-all duration-200"
        >
          <!-- Hamburger icon -->
          <svg id="icon-hamburger" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" y1="6" x2="20" y2="6"/>
            <line x1="4" y1="12" x2="20" y2="12"/>
            <line x1="4" y1="18" x2="20" y2="18"/>
          </svg>
          <!-- Close icon -->
          <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>

      </div>
    </div>

    <!-- Mobile menu dropdown -->
    <div
      id="mobile-menu"
      class="md:hidden overflow-hidden transition-all duration-300 ease-in-out max-h-0 opacity-0"
      aria-hidden="true"
    >
      <nav aria-label="Mobile navigation" class="flex flex-col pt-3 pb-2 gap-1 border-t border-border/40 mt-3">
        {name && (
          <a
            href={`/${currentLocale}`}
            class={cls("text-sm px-2 py-1.5 rounded transition-all duration-200 active:scale-[0.98]", isActive(`/${currentLocale}`) ? "text-foreground font-medium hover:bg-foreground/8 hover:text-foreground" : "text-muted-foreground hover:text-foreground hover:bg-foreground/8")}
          >
            {homeLabel}
          </a>
        )}
        {nav.map((item) => (
          <I18NDebug key={item.text}>
            <a
              class={cls(
                "text-sm px-2 py-1.5 rounded transition-all duration-200 active:scale-[0.98]",
                isActive(item.path)
                  ? "text-foreground font-medium hover:bg-foreground/8 hover:text-foreground"
                  : "text-muted-foreground hover:text-foreground hover:bg-foreground/8"
              )}
              href={resolveHref(item.path)}
              aria-current={isActive(item.path) ? "page" : undefined}
            >
              {item.text}
            </a>
          </I18NDebug>
        ))}
      </nav>
    </div>

  </div>
</header>

<script>
  // ── Theme toggle ──────────────────────────────────────────────
  function initTheme() {
    const html = document.documentElement;
    const btn = document.getElementById('theme-toggle');
    const sunIcon = document.getElementById('icon-sun');
    const moonIcon = document.getElementById('icon-moon');
    if (!btn || !sunIcon || !moonIcon) return;

    const stored = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const isDark = stored ? stored === 'dark' : (stored === null ? prefersDark ?? true : false);

    function applyTheme(dark: boolean) {
      if (dark) {
        html.classList.add('dark');
        sunIcon!.classList.remove('hidden');
        moonIcon!.classList.add('hidden');
      } else {
        html.classList.remove('dark');
        sunIcon!.classList.add('hidden');
        moonIcon!.classList.remove('hidden');
      }
    }

    applyTheme(isDark);
    btn.addEventListener('click', () => {
      const next = !html.classList.contains('dark');
      localStorage.setItem('theme', next ? 'dark' : 'light');
      applyTheme(next);
    });
  }

  // ── Hamburger menu ────────────────────────────────────────────
  function initMobileMenu() {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const hamburger = document.getElementById('icon-hamburger');
    const close = document.getElementById('icon-close');
    if (!toggle || !menu || !hamburger || !close) return;

    let open = false;

    function setMenu(state: boolean) {
      open = state;
      toggle!.setAttribute('aria-expanded', String(state));
      menu!.setAttribute('aria-hidden', String(!state));
      if (state) {
        menu!.classList.remove('max-h-0', 'opacity-0');
        menu!.classList.add('max-h-[999px]', 'opacity-100');
        hamburger!.classList.add('hidden');
        close!.classList.remove('hidden');
      } else {
        menu!.classList.add('max-h-0', 'opacity-0');
        menu!.classList.remove('max-h-[999px]', 'opacity-100');
        hamburger!.classList.remove('hidden');
        close!.classList.add('hidden');
      }
    }

    toggle.addEventListener('click', () => setMenu(!open));

    // Close when a nav link is clicked
    menu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => setMenu(false));
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      const header = document.querySelector('[data-testid="site-header"]');
      if (open && header && !header.contains(e.target as Node)) {
        setMenu(false);
      }
    });
  }

  initTheme();
  initMobileMenu();
  document.addEventListener('astro:after-swap', () => {
    initTheme();
    initMobileMenu();
  });
</script>
