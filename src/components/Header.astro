---
import I18NDebug from "@ariaskit/astro-i18n/I18NDebug.astro";
import { useI18n } from "@ariaskit/astro-i18n";
import { type LocaleSchema } from "@/src/types";
import { cls } from "@/src/lib/utils";
import { RESUME_HREF } from "@/src/lib/page-helpers";

type Locales = "es" | "en"

interface Props {
    nav:{path:string;text:string;divider?:boolean}[];
    locales: Locales[];
    currentLocale:string;
    name?: string;
    currentPath?: string;
}

const { nav, locales, currentLocale, name, currentPath = "" } = Astro.props as Props

/**
 * Resolved here, not passed in. Both were props with English defaults ("home",
 * "Resume"), and any page that forgot to pass them silently rendered English
 * inside a Spanish page. Two pages did exactly that.
 */
const { t } = useI18n<LocaleSchema>({ ssg: { astro: Astro } });
const homeLabel = t("nav.home");
const resumeLabel = t("nav.resume");

function resolveHref(path: string): string {
    return path.startsWith('/') ? path : `/${currentLocale}/${path}`;
}

function isActive(path: string): boolean {
    const href = resolveHref(path);
    if (href.includes('#')) return false;
    return currentPath.startsWith(href);
}

/**
 * Home needs an exact match: every route under /en starts with /en, so a
 * prefix check marked "home" as current on /en/blog, /en/blog/<slug> and
 * every tag page.
 */
function isHome(): boolean {
    return currentPath === `/${currentLocale}` || currentPath === `/${currentLocale}/`;
}

/** Anchors get a section key so the scroll-spy can track them. */
function spyKey(path: string): string | undefined {
    return path.startsWith('#') ? path.slice(1) : undefined;
}

// Active styling lives in global.css, keyed on aria-current, so the
// server-rendered route state and the scroll-spy share one source of truth.
// px-1.5 on phones, px-2 from md: three short labels plus the theme and
// language controls have to share 320px on the narrowest supported screen.
// Measured in Spanish, the longest locale: 39px of slack left over.
const navLinkClass = cls(
    "relative transition-all duration-200 text-[0.8125rem] md:text-sm whitespace-nowrap px-1.5 md:px-2 py-1 rounded active:scale-[0.97]",
    "text-muted-foreground hover:text-foreground",
    "after:absolute after:bottom-0 after:left-0 after:right-0 after:h-px after:bg-amber-accent after:transition-transform after:duration-200 after:origin-left"
);
---

<header data-testid="site-header" class="py-3 md:py-5 fixed top-0 left-0 right-0 bg-header-gradient backdrop-blur-xl backdrop-saturate-150 z-40 w-full max-w-[100vw] border-b border-border/40 transition-shadow duration-300">
  <div class="w-full max-w-3xl mx-auto px-5 md:px-0">

    <!-- One row, every screen: three labels fit beside the theme and language
         controls down to 320px, so the hamburger and its dropdown are gone.
         The nav is the same element at every width, which also means the
         scroll-spy and the active underline cannot drift apart. -->
    <div class="flex items-center justify-between">

      <!-- Nav links -->
      <nav data-testid="main-nav" class="flex items-center gap-x-1 flex-1 justify-start min-w-0" aria-label="Main navigation">
        {name && (
          <a
            data-testid="nav-home"
            data-spy-home
            href={`/${currentLocale}/`}
            aria-current={isHome() ? 'page' : undefined}
            class={navLinkClass}
          >
            {homeLabel}
          </a>
        )}
        {nav.map((item) => (
          <>
            {item.divider && (
              <span aria-hidden="true" class="h-3 w-px shrink-0 self-center bg-border mx-1.5" />
            )}
          <I18NDebug key={item.text}>
            <a
              data-testid={`nav-${item.text.toLowerCase()}`}
              data-spy={spyKey(item.path)}
              class={navLinkClass}
              href={resolveHref(item.path)}
              aria-current={isActive(item.path) ? "page" : undefined}
            >
              {item.text}
            </a>
          </I18NDebug>
          </>
        ))}
      </nav>

      <!-- Right: controls. The resume lives here on desktop, not in the
           top-left corner: that slot is for identity, and a lone chip there
           read as a leftover. On phones it would push the nav off the row, so
           it lives in the hero (where the call to action is) and in the footer
           (where it is reachable from every page). -->
      <div class="flex items-center gap-1.5 md:gap-2 shrink-0">

        <a
          data-testid="resume-button"
          href={RESUME_HREF}
          target="_blank"
          rel="noopener noreferrer"
          onclick="window.umami?.track('Resume Download')"
          class="hidden md:inline-flex text-xs transition-all duration-200 rounded px-2.5 py-1 items-center border border-border/60 text-muted-foreground hover:border-amber-accent hover:text-amber-text hover:bg-amber-accent/5 active:scale-[0.97] shrink-0"
        >
          {resumeLabel}
        </a>


        <!-- Theme toggle -->
        <button
          id="theme-toggle"
          data-testid="theme-toggle"
          aria-label="Toggle appearance"
          class="text-muted-foreground hover:text-foreground hover:bg-foreground/8 transition-all duration-200 flex items-center justify-center w-7 h-7 rounded"
        >
          <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
          </svg>
          <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>

        <!-- Locale switcher -->
        <div data-testid="locale-switcher" class="flex items-center gap-0.5">
          {locales.map(item =>
            <a
              data-testid={`locale-${item.toLowerCase()}`}
              href={`/${item.toLowerCase()}/`}
              class={cls("uppercase text-[0.8125rem] md:text-sm cursor-pointer transition-all duration-200 px-1 py-1 rounded hover:bg-foreground/8", item === currentLocale.toLowerCase() ? "text-foreground" : "text-muted-foreground hover:text-foreground")}
            >
              {item}
            </a>
            <span class="last:hidden text-muted-foreground text-sm">/</span>
          )}
        </div>

      </div>
    </div>

  </div>
</header>

<script>
  // ── Theme toggle ──────────────────────────────────────────────
  function initTheme() {
    const html = document.documentElement;
    const btn = document.getElementById('theme-toggle');
    const sunIcon = document.getElementById('icon-sun');
    const moonIcon = document.getElementById('icon-moon');
    if (!btn || !sunIcon || !moonIcon) return;

    const stored = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const isDark = stored ? stored === 'dark' : (stored === null ? prefersDark ?? true : false);

    function applyTheme(dark: boolean) {
      if (dark) {
        html.classList.add('dark');
        sunIcon!.classList.remove('hidden');
        moonIcon!.classList.add('hidden');
      } else {
        html.classList.remove('dark');
        sunIcon!.classList.add('hidden');
        moonIcon!.classList.remove('hidden');
      }
    }

    applyTheme(isDark);
    btn.addEventListener('click', () => {
      const next = !html.classList.contains('dark');
      localStorage.setItem('theme', next ? 'dark' : 'light');
      applyTheme(next);
    });
  }


  // ── Scroll spy ────────────────────────────────────────────────
  // On the homepage the nav items are in-page anchors, so without this the
  // only item that could ever look current was "home" — it stayed marked
  // wherever you scrolled. On other routes the anchors point back at the
  // homepage, so the build-time aria-current is left alone.
  function initScrollSpy() {
    const homes = Array.from(document.querySelectorAll('[data-spy-home]'));
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-spy]'));
    if (!homes.length || !items.length) return;

    const ordered = Array.from(new Set(items.map((el) => el.dataset.spy).filter(Boolean)))
      .map((key) => ({ key: key as string, el: document.getElementById(key as string) }))
      .filter((s) => s.el)
      .sort((a, b) => (a.el as HTMLElement).offsetTop - (b.el as HTMLElement).offsetTop);

    if (!ordered.length) return;

    function apply(key: string | null) {
      homes.forEach((el) => el.removeAttribute('aria-current'));
      items.forEach((el) => el.removeAttribute('aria-current'));
      const targets = key ? items.filter((el) => el.dataset.spy === key) : homes;
      targets.forEach((el) => el.setAttribute('aria-current', 'page'));
    }

    let ticking = false;
    function update() {
      ticking = false;
      // a section becomes current once its top passes the middle of the viewport
      const line = window.scrollY + window.innerHeight * 0.5;
      let active: string | null = null;
      for (const entry of ordered) {
        if (line >= (entry.el as HTMLElement).offsetTop) active = entry.key;
      }
      apply(active);
    }
    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    update();
  }

  // ── Hamburger menu ────────────────────────────────────────────
  // Removed in favour of a single row: three labels fit beside the theme and
  // language controls at 320px, and a menu that hides the only navigation
  // behind a tap is a cost with no benefit at that size.

  initTheme();
  initScrollSpy();
  document.addEventListener('astro:after-swap', () => {
    initTheme();
    initScrollSpy();
  });
</script>
