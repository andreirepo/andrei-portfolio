---
import I18NDebug from "@ariaskit/astro-i18n/I18NDebug.astro";
import { cls } from "@/src/lib/utils";

type Locales = "es" | "en"

interface Props {
    nav:{path:string;text:string}[];
    locales: Locales[];
    currentLocale:string;
    resumeLabel?: string;
    name?: string;
    homeLabel?: string;
    currentPath?: string;
}

const { nav, locales, currentLocale, resumeLabel = "Resume", name, homeLabel = "home", currentPath = "", id } = Astro.props as Props

// Cache busting: use git commit hash or timestamp
const RESUME_VERSION = "1";

// Resolve the full href for a nav item (same logic as the template)
function resolveHref(path: string): string {
    return path.startsWith('/') ? path : `/${currentLocale}/${path}`;
}

// A nav item is active if the current path starts with its resolved href,
// but only for real page routes (not hash anchors on the same page)
function isActive(path: string): boolean {
    const href = resolveHref(path);
    if (href.includes('#')) return false; // anchor links on home page — never mark active
    return currentPath.startsWith(href);
}
---

<header data-testid="site-header" id={id} class="py-4 md:py-8 px-5 md:px-0 flex items-center justify-between flex-col md:flex-row fixed top-0 left-1/2 -translate-x-1/2 bg-header-gradient backdrop-blur-md z-40 w-full max-w-2xl">
    <!-- Nav links -->
    <nav data-testid="main-nav" class="flex items-center gap-x-2 md:gap-x-3 gap-y-1 order-2 md:order-1 flex-1 justify-center md:justify-start w-full md:w-auto pb-1 md:pb-0 overflow-x-auto" aria-label="Main navigation">
        {name && (
                         <a
                                 data-testid="nav-home"
                                 href={`/${currentLocale}`}
                                 class="text-sm text-muted-foreground transition-all duration-200 hover:bg-amber-accent-bg hover:text-background py-0.5 hover:scale-[1.02] active:scale-[0.98]"
                             >
                                 {homeLabel}
                             </a>
        )}
        {
            nav.map((item) => (
                <I18NDebug key={item.text}>
                    <a
                        data-testid={`nav-${item.text.toLowerCase()}`}
                        class={cls(
                            "transition-all duration-200 text-sm whitespace-nowrap py-0.5",
                            isActive(item.path) ? "text-foreground" : "text-muted-foreground hover:bg-amber-accent-bg hover:text-background"
                        )}
                        href={resolveHref(item.path)}
                        aria-current={isActive(item.path) ? "page" : undefined}
                    >
                        {item.text}
                    </a>
                </I18NDebug>
            ))
        }
    </nav>

    <!-- Right controls: Resume + Theme + Locale -->
    <div class="order-1 md:order-2 mb-2 md:mb-0 flex items-center gap-3 flex-none justify-between md:justify-end w-full md:w-auto">

        <!-- Resume download link -->
        <a
            data-testid="resume-button"
            href={`/assets/AndreiRepoResume.pdf?v=${RESUME_VERSION}`}
            target="_blank"
            rel="noopener noreferrer"
            onclick="umami.track('Resume Download')"
            class="text-sm transition-all duration-200 rounded px-2 py-0.5 leading-tight bg-amber-accent-bg hover:bg-amber-accent-bg-hover text-white"
        >
            {resumeLabel}
        </a>

        <!-- Theme + Locale grouped right on mobile -->
        <div class="flex items-center gap-3">

        <!-- Appearance toggle -->
        <button
            id="theme-toggle"
            data-testid="theme-toggle"
            aria-label="Toggle appearance"
            class="text-muted-foreground hover:text-foreground transition-all duration-200 flex items-center justify-center w-6 h-6"
        >
            <!-- Sun icon (shown in dark mode) -->
            <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
                <circle cx="12" cy="12" r="4"/>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
            </svg>
            <!-- Moon icon (shown in light mode) -->
            <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
        </button>

        <!-- Locale switcher -->
        <div data-testid="locale-switcher" class="flex items-center gap-1">
            {
                locales.map(item =>
                    <a data-testid={`locale-${item.toLowerCase()}`} href={`/${item.toLowerCase()}`} class={cls("uppercase text-sm hover:text-foreground cursor-pointer text-muted-foreground transition-all duration-200", item === currentLocale.toLowerCase() && "text-foreground")}>
                        {item}
                    </a>
                    <span class="last:hidden text-muted-foreground text-sm">/</span>
                )
            }
        </div>

        </div>
    </div>

    <div class="absolute -bottom-10 left-0 w-full h-18 pointer-events-none bg-linear-to-b from-background/60 via-background/30 to-transparent z-10"></div>
</header>

<script>
    function initTheme() {
        const html = document.documentElement;
        const btn = document.getElementById('theme-toggle');
        const sunIcon = document.getElementById('icon-sun');
        const moonIcon = document.getElementById('icon-moon');

        if (!btn || !sunIcon || !moonIcon) return;

        // Determine initial theme: localStorage > system preference > default dark
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = stored ? stored === 'dark' : (stored === null ? prefersDark ?? true : false);

        function applyTheme(dark: boolean) {
            if (dark) {
                html.classList.add('dark');
                sunIcon!.classList.remove('hidden');
                moonIcon!.classList.add('hidden');
            } else {
                html.classList.remove('dark');
                sunIcon!.classList.add('hidden');
                moonIcon!.classList.remove('hidden');
            }
        }

        applyTheme(isDark);

        btn.addEventListener('click', () => {
            const currentlyDark = html.classList.contains('dark');
            const next = !currentlyDark;
            localStorage.setItem('theme', next ? 'dark' : 'light');
            applyTheme(next);
        });
    }

    // Run on initial load and after Astro view transitions
    initTheme();
    document.addEventListener('astro:after-swap', initTheme);
</script>