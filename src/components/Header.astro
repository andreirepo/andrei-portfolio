---
import I18NDebug from "@ariaskit/astro-i18n/I18NDebug.astro";
import { cls } from "@/src/lib/utils";

type Locales = "es" | "en"

interface Props {
    nav:{path:string;text:string}[];
    locales: Locales[];
    currentLocale:string;
    resumeLabel?: string;
    name?: string;
}

const { nav, locales, currentLocale, resumeLabel = "Resume", name } = Astro.props as Props

// Cache busting: use git commit hash or timestamp
const RESUME_VERSION = "1";
---

<header class="py-8 px-5 md:px-0 flex items-center justify-between flex-col md:flex-row fixed top-0 left-1/2 -translate-x-1/2 bg-background z-40 w-full max-w-2xl">
    <!-- Nav links -->
    <nav class="flex items-center gap-4 order-2 md:order-1 flex-1 justify-center md:justify-start w-full md:w-auto" aria-label="Main navigation">
        {name && (
            <a
                href={`/${currentLocale}`}
                class="opacity-50 transition-all duration-200 hover:opacity-100 text-[0.8rem] md:text-[0.85rem] mr-2"
            >
                home
            </a>
        )}
        {
            nav.map((item) => (
                <I18NDebug key={item.text}>
                    <a
                        class="opacity-50 transition-all duration-200 hover:opacity-100 text-[0.8rem] md:text-[0.85rem]"
                        href={`/${currentLocale}/${item.path}`}
                    >
                        {item.text}
                    </a>
                </I18NDebug>
            ))
        }
    </nav>

    <!-- Right controls: Resume + Theme + Locale -->
    <div class="order-1 md:order-2 mb-4 md:mb-0 flex items-center gap-3 flex-1 justify-center md:justify-end w-full md:w-auto">

        <!-- Resume download link -->
        <a
            href={`/assets/AndreiRepoResume.pdf?v=${RESUME_VERSION}`}
            target="_blank"
            rel="noopener noreferrer"
            onclick="umami.track('Resume Download')"
            class="text-[0.8rem] md:text-[0.85rem] transition-all duration-200 rounded px-2 py-0.5 leading-tight bg-green-600 hover:bg-green-500 text-white opacity-90 hover:opacity-100"
        >
            {resumeLabel}
        </a>

        <!-- Appearance toggle -->
        <button
            id="theme-toggle"
            aria-label="Toggle appearance"
            class="opacity-70 hover:opacity-100 transition-all duration-200 flex items-center justify-center w-6 h-6"
        >
            <!-- Sun icon (shown in dark mode) -->
            <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
                <circle cx="12" cy="12" r="4"/>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
            </svg>
            <!-- Moon icon (shown in light mode) -->
            <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
        </button>

        <!-- Locale switcher -->
        <div class="flex items-center space-x-2 md:space-x-0">
            {
                locales.map(item =>
                    <a href={`/${item.toLowerCase()}`} class={cls("uppercase text-[1.2rem] md:text-[0.9rem] hover:opacity-100 cursor-pointer opacity-70 transition-all duration-200", item === currentLocale.toLowerCase() && "opacity-100")}>
                        {item}
                    </a>
                    <span class="last:hidden opacity-50 text-[1.2rem] md:text-[0.9rem]">/</span>
                )
            }
        </div>
    </div>

    <div class="absolute -bottom-10 left-0 w-full h-18  pointer-events-none bg-linear-to-b from-background via-background/80 to-background/20 z-10"></div>
</header>

<script>
    function initTheme() {
        const html = document.documentElement;
        const btn = document.getElementById('theme-toggle');
        const sunIcon = document.getElementById('icon-sun');
        const moonIcon = document.getElementById('icon-moon');

        if (!btn || !sunIcon || !moonIcon) return;

        // Determine initial theme: localStorage > system preference > default dark
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = stored ? stored === 'dark' : (stored === null ? prefersDark ?? true : false);

        function applyTheme(dark: boolean) {
            if (dark) {
                html.classList.add('dark');
                sunIcon!.classList.remove('hidden');
                moonIcon!.classList.add('hidden');
            } else {
                html.classList.remove('dark');
                sunIcon!.classList.add('hidden');
                moonIcon!.classList.remove('hidden');
            }
        }

        applyTheme(isDark);

        btn.addEventListener('click', () => {
            const currentlyDark = html.classList.contains('dark');
            const next = !currentlyDark;
            localStorage.setItem('theme', next ? 'dark' : 'light');
            applyTheme(next);
        });
    }

    // Run on initial load and after Astro view transitions
    initTheme();
    document.addEventListener('astro:after-swap', initTheme);
</script>
