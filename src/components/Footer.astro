---
type Option = { key:string; value:string }

interface Props {
    status: Option;
    heading: Option;
    description: Option;
    id: string;
    email_label?: Option;
    email_url?: Option;
    github_label?: Option;
    github_url?: Option;
    linkedin_label?: Option;
    linkedin_url?: Option;
}

const { status, heading, description, email_label, email_url, github_label, github_url, linkedin_label, linkedin_url, id } = Astro.props as Props
---

<footer
    data-testid="site-footer"
    id={id}
    class="my-24 border-t pt-12 text-sm"
>
    <div class="text-center mb-8">
        <div class="mb-4">
            <span class="inline-block w-2 h-2 rounded-full bg-green-accent-bg mr-2 animate-pulse"></span>
            <span class="text-muted-foreground uppercase text-xs">{status.value}</span>
            <span class="inline-block w-2 h-2 rounded-full bg-green-accent-bg ml-2 animate-pulse"></span>
        </div>
        <h2 class="text-xl font-semibold mb-2">{heading.value}</h2>
        <p class="text-muted-foreground max-w-md mx-auto">{description.value}</p>
    </div>
    
    <div class="flex flex-wrap justify-center gap-3 mb-12">
        {email_url && email_label && (
            <a 
                href={email_url.value}
                class="border rounded px-5 py-2 text-muted-foreground hover:text-foreground hover:border-green-accent transition-all duration-200"
            >
                {email_label.value}
            </a>
        )}
        
        {github_url && github_label && (
            <a 
                href={github_url.value}
                target="_blank" 
                rel="noopener noreferrer"
                class="border rounded px-5 py-2 text-muted-foreground hover:text-foreground hover:border-green-accent transition-all duration-200"
            >
                {github_label.value}
            </a>
        )}

        {linkedin_url && linkedin_label && (
            <a 
                href={linkedin_url.value}
                target="_blank" 
                rel="noopener noreferrer"
                class="border rounded px-5 py-2 text-muted-foreground hover:text-foreground hover:border-green-accent transition-all duration-200"
            >
                {linkedin_label.value}
            </a>
        )}
    </div>

    <div class="border-t pt-6 text-center text-muted-foreground text-xs">
        <p>&copy; 2026 Andrei Repo</p>
    </div>
</footer>
