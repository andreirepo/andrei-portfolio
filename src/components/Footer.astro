---
import CIStatus from "@/src/components/CIStatus.astro";

type Option = { key:string; value:string }

interface Props {
    id: string;
    email_label?: Option;
    email_url?: Option;
    github_label?: Option;
    github_url?: Option;
    linkedin_label?: Option;
    linkedin_url?: Option;
}

const { email_label, email_url, github_label, github_url, linkedin_label, linkedin_url, id } = Astro.props as Props

const linkClass = "transition-colors duration-200 hover:text-foreground";
const sepClass = "hidden sm:inline text-muted-foreground/30";
---

<footer
    data-testid="site-footer"
    id={id}
    class="mt-16 pb-10 border-t border-border pt-6 text-xs text-muted-foreground"
>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
        <p>&copy; <span id="copyright-year">2026</span> Andrei Repo</p>

        <span aria-hidden="true" class={sepClass}>·</span>

        <nav aria-label="Contact" class="flex flex-wrap items-center gap-x-4 gap-y-1">
            {email_url && email_label && (
                <a href={email_url.value} class={linkClass}>{email_label.value}</a>
            )}
            {github_url && github_label && (
                <a href={github_url.value} target="_blank" rel="noopener noreferrer" class={linkClass}>
                    {github_label.value}
                </a>
            )}
            {linkedin_url && linkedin_label && (
                <a href={linkedin_url.value} target="_blank" rel="noopener noreferrer" class={linkClass}>
                    {linkedin_label.value}
                </a>
            )}
        </nav>

        <span aria-hidden="true" class={sepClass}>·</span>

        <CIStatus repo="andreirepo/andrei-portfolio" workflow="ci-cd.yml" />
    </div>
</footer>
