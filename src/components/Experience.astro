---
import I18NDebug from "@ariaskit/astro-i18n/I18NDebug.astro";

type Out = { key: string; value: string };

interface JobExp {
    period: Out;
    role: Out;
    company: Out;
    description: Out;
}

interface Props {
    title: Out;
    jobs: JobExp[];
}

const { title, jobs } = Astro.props as Props;
---

<section data-testid="experience-section" id={title.value.toLowerCase()} class="scroll-mt-24 mt-16 section-fade-in">
    <h2 class="text-amber-accent font-serif font-medium tracking-tight mb-8 text-[1.75rem] md:text-[2rem]">
        <I18NDebug key={title.key}>
            {title.value}
        </I18NDebug>
    </h2>
    <ul class="space-y-8">
        {
            jobs.map((job) => (
                <li data-testid="experience-item" class="experience-grid grid gap-x-4 items-baseline">
                    <span class="text-muted-foreground text-sm text-right whitespace-nowrap">
                        <I18NDebug key={job.period.key}>
                            {job.period.value}
                        </I18NDebug>
                    </span>
                    <div class="border-l-2 border-border pl-4 rounded-r">
                        <div class="mb-2">
                            <I18NDebug key={job.role.key}>
                                <span class="font-serif font-medium text-foreground">{job.role.value}</span>
                            </I18NDebug>
                            <span class="text-muted-foreground mx-2">·</span>
                            <I18NDebug key={job.company.key}>
                                <span class="text-muted-foreground">{job.company.value}</span>
                            </I18NDebug>
                        </div>
                        <I18NDebug key={job.description.key}>
                            <p class="text-sm text-muted-foreground leading-relaxed">
                                {job.description.value}
                            </p>
                        </I18NDebug>
                    </div>
                </li>
            ))
        }
    </ul>
</section>
