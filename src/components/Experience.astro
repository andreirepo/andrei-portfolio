---
import I18NDebug from "@ariaskit/astro-i18n/I18NDebug.astro";

type Out = { key: string; value: string };

interface JobExp {
    period: Out;
    role: Out;
    company: Out;
    description: Out;
}

interface Props {
    title: Out;
    jobs: JobExp[];
}

const { title, jobs } = Astro.props as Props;
---

<section data-testid="experience-section" id={title.value.toLowerCase()} class="scroll-mt-50">
    <h2 class="text-muted-foreground uppercase mb-6 mt-15">
        <I18NDebug key={title.key}>
            {title.value}
        </I18NDebug>
    </h2>
    <ul>
        {
            jobs.map((job) => (
                <li data-testid="experience-item" class="mb-4 flex items-baseline gap-x-6">
                                    <span class="text-muted-foreground text-sm min-w-[120px]">
                        <I18NDebug key={job.period.key}>
                            {job.period.value}
                        </I18NDebug>
                    </span>
                    <div class="flex-1">
                        <div class="mb-1">
                            <I18NDebug key={job.role.key}>
                                <span class="font-medium">{job.role.value}</span>
                            </I18NDebug>
                            <span class="text-muted-foreground">|</span>
                            <I18NDebug key={job.company.key}>
                                <span>{job.company.value}</span>
                            </I18NDebug>
                        </div>
                        <I18NDebug key={job.description.key}>
                            <p class="text-sm text-muted-foreground">
                                {job.description.value}
                            </p>
                        </I18NDebug>
                    </div>
                </li>
            ))
        }
    </ul>
</section>
