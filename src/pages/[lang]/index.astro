---
export const getStaticPaths = () => {
  return [
    { params: { lang: "en" } },
    { params: { lang: "es" } },
  ];
};

import Layout from "@/src/layouts/Layout.astro";
import { useI18n } from "@ariaskit/astro-i18n";
import { type LocaleSchema } from "@/src/types";
import Header from "@/src/components/Header.astro";
import Hero from "@/src/components/Hero.astro";
import Projects from "@/src/components/Projects.astro";
import Experience from "@/src/components/Experience.astro";
import LatestPosts from "@/src/components/LatestPosts.astro";
import Footer from "@/src/components/Footer.astro";
import { buildNav, buildFooter, RESUME_HREF } from "@/src/lib/page-helpers";

const { t, locale } = useI18n<LocaleSchema>({
  ssg: {
    astro: Astro,
  },
});

const nav = buildNav(t, locale, true);

const heroProps = {
  name: "Andrei Repo",
  title: { key: "hero.title", value: t("hero.title") },
  roleDetail: { key: "hero.role_detail", value: t("hero.role_detail") },
  availability: { key: "hero.availability", value: t("hero.availability") },
  pitch: { key: "hero.pitch", value: t("hero.pitch") },
  pitchResult: { key: "hero.pitch_result", value: t("hero.pitch_result") },
  proof: [
    { key: "hero.proof.axe", value: t("hero.proof.axe") },
    { key: "hero.proof.ci", value: t("hero.proof.ci") },
    { key: "hero.proof.istqb", value: t("hero.proof.istqb") },
    { key: "hero.proof.aws", value: t("hero.proof.aws") },
  ],
  ctaEmail: { key: "hero.cta_email", value: t("hero.cta_email") },
  ctaResume: { key: "hero.cta_resume", value: t("hero.cta_resume") },
  ctaLinkedin: { key: "hero.cta_linkedin", value: t("hero.cta_linkedin") },
  location: { key: "hero.location", value: t("hero.location") },
  emailHref: t("contact.email_url"),
  resumeHref: RESUME_HREF,
  linkedinHref: t("contact.linkedin_url"),
};

const projects = [
  {
    name: t("projects.item_1.name"),
    description: t("projects.item_1.description"),
    link: t("projects.item_1.link"),
    demo: t("projects.item_1.demo"),
  },
  {
    name: t("projects.item_2.name"),
    description: t("projects.item_2.description"),
    link: t("projects.item_2.link"),
    demo: t("projects.item_2.demo"),
  },
];

const projectsProps = {
  title: { key: "projects.title", value: t("projects.title") },
  projects,
};

const experienceData = {
  title: {
    key: "experience.title",
    value: t("experience.title"),
  },
  jobs: [
    {
      period: {
        key: "experience.item_1.period",
        value: t("experience.item_1.period"),
      },
      role: {
        key: "experience.item_1.role",
        value: t("experience.item_1.role"),
      },
      company: {
        key: "experience.item_1.company",
        value: t("experience.item_1.company"),
      },
      description: {
        key: "experience.item_1.description",
        value: t("experience.item_1.description"),
      },
    },
    {
      period: {
        key: "experience.item_2.period",
        value: t("experience.item_2.period"),
      },
      role: {
        key: "experience.item_2.role",
        value: t("experience.item_2.role"),
      },
      company: {
        key: "experience.item_2.company",
        value: t("experience.item_2.company"),
      },
      description: {
        key: "experience.item_2.description",
        value: t("experience.item_2.description"),
      },
    },
    {
      period: {
        key: "experience.item_3.period",
        value: t("experience.item_3.period"),
      },
      role: {
        key: "experience.item_3.role",
        value: t("experience.item_3.role"),
      },
      company: {
        key: "experience.item_3.company",
        value: t("experience.item_3.company"),
      },
      description: {
        key: "experience.item_3.description",
        value: t("experience.item_3.description"),
      },
    }
  ],
};

const alternate = [
  { href: "/es/", hreflang: "es" },
  { href: "/en/", hreflang: "en" },
  // x-default is required for the page to be picked when no locale matches.
  // Trailing slashes here must match the canonical, or the two disagree.
  { href: "/en/", hreflang: "x-default" },
];

const SITE = Astro.site ?? new URL("https://andreirepo.com/");

const profilePageSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": new URL(`/${locale}/#profilepage`, SITE).href,
  url: new URL(`/${locale}/`, SITE).href,
  name: "Andrei Repo – Senior QA Engineer",
  inLanguage: locale,
  isPartOf: { "@id": new URL("/#website", SITE).href },
  about: { "@id": new URL("/#person", SITE).href },
  mainEntity: { "@id": new URL("/#person", SITE).href },
};

const footerContent = buildFooter(t);
---

<Layout
  locale={locale}
  title="Andrei Repo – Senior QA Engineer"
  description={t("description")}
  alternateLinks={alternate}
  schema={profilePageSchema}
>
  <Header nav={nav} locales={["en", "es"]} currentLocale={locale} resumeLabel={t("nav.resume")} name="Andrei Repo" homeLabel={t("nav.home")} currentPath={Astro.url.pathname} />

  <main id="main-content">
    <Hero {...heroProps} />
    <Projects {...projectsProps} />
    <LatestPosts
      lang={locale}
      title={t("blog.latest_title")}
      seeAllLabel={t("blog.see_all")}
      seeAllHref={`/${locale}/blog/`}
    />
    <Experience {...experienceData} />
  </main>

  <Footer {...footerContent} />
</Layout>