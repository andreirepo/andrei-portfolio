---
export const getStaticPaths = () => [
  { params: { lang: "en" } },
  { params: { lang: "es" } },
];

import { getCollection } from "astro:content";
import Layout from "@/src/layouts/Layout.astro";
import Header from "@/src/components/Header.astro";
import Footer from "@/src/components/Footer.astro";
import BlogCard from "@/src/components/BlogCard.astro";
import { useI18n } from "@ariaskit/astro-i18n";
import { type LocaleSchema } from "@/src/types";
import { buildNav, buildFooter } from "@/src/lib/page-helpers";

const { lang } = Astro.params;
const { t, locale } = useI18n<LocaleSchema>({ ssg: { astro: Astro } });

// Fetch posts for current locale; fall back to English if none
let posts = await getCollection("blog", ({ id, data }) =>
  id.startsWith(`${lang}/`) && !data.draft
);

if (posts.length === 0 && lang !== "en") {
  posts = await getCollection("blog", ({ id, data }) =>
    id.startsWith("en/") && !data.draft
  );
}

posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const nav = buildNav(t, locale);

const alternate = [
  { href: "/es/blog/", hreflang: "es" },
  { href: "/en/blog/", hreflang: "en" },
  { href: "/en/blog/", hreflang: "x-default" },
];

const footerContent = buildFooter(t);
---

<Layout
  locale={locale}
  title={`${t("blog.title")} – Andrei Repo`}
  description={t("description")}
  alternateLinks={alternate}
>
  <Header nav={nav} locales={["en", "es"]} currentLocale={locale} name="Andrei Repo" currentPath={Astro.url.pathname} />

  <main id="main-content" class="pt-24 md:pt-32">
    <div class="section-head" style="padding-top: 0; border-top: 0;">
      <h1 data-testid="blog-index-heading" class="font-serif font-medium text-[1.75rem] leading-[1.2] tracking-[-0.02em] text-foreground">
        {t("blog.title")}
      </h1>
    </div>
    {lang !== "en" && (
      <p class="mb-6 text-xs text-muted-foreground">{t("blog.language_note")}</p>
    )}

    {posts.length === 0 ? (
      <p class="text-muted-foreground">{t("blog.empty")}</p>
    ) : (
      <ul data-testid="blog-post-list" class="flex flex-col gap-6">
        {posts.map((post) => {
          const slug = post.id.replace(/^(en|es)\//, "").replace(/\.md$/, "");
          return (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              tags={post.data.tags}
              slug={slug}
              lang={locale}
            />
          );
        })}
      </ul>
    )}
  </main>

  <Footer {...footerContent} />
</Layout>
