---
import { PageMetadata } from "@/src/components/hybrid-astro-ui/page-metadata";
import OGImage from "@/src/assets/background.png"

interface Props {
	title: string;
	description: string;
	locale: string;
	alternateLinks?: { href: string; hreflang: string }[];
}

const { title, description, locale, alternateLinks } =
	Astro.props as Props;
---

<!doctype html>
<html lang={locale}>
	<head>
		<!-- Blocking theme script: must run before render to avoid flash -->
		<script is:inline>
			(function() {
				var stored = localStorage.getItem('theme');
				var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				var isDark = stored === 'light' ? false : stored === 'dark' ? true : prefersDark !== undefined ? prefersDark : true;
				if (isDark) document.documentElement.classList.add('dark');
			})();
		</script>
		<PageMetadata
			lang={locale}
			title={title}
			description={description}
			image={OGImage}
			enableClientRouter
			ogType="website"
			favicons={[
				{ rel: "icon", type: "image/svg+xml", href: "/favicon.svg" },
				{ rel: "manifest", href: "/site.webmanifest" },
			]}
			alternateLinks={alternateLinks}
		/>
		<!-- Schema.org structured data -->
		<script is:inline type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "Person",
				"name": "Andrei",
				"url": "https://andreirepo.com",
				"jobTitle": "Senior QA Engineer",
				"description": "Senior QA Engineer specializing in highly regulated iGaming",
				"sameAs": [
					"https://github.com/andreirepo",
					"https://linkedin.com/in/andreirepo"
				],
				"knowsAbout": [
					"QA Engineering",
					"Test Automation",
					"Playwright",
					"Cypress",
					"iGaming",
					"AWS",
					"Docker"
				]
			}
		</script>
		<!-- Umami Analytics -->
		<script defer src="https://analytics.andreirepo.com/script.js" data-website-id="01aef085-1248-4ed6-939d-5a0660cb4bc4"></script>
	</head>
	<body class="*:max-w-2xl *:w-full flex flex-col items-center w-full font-mono px-5 md:px-0 leading-10" >
		<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:bg-green-600 focus:text-white focus:px-4 focus:py-2 focus:rounded focus:z-50">
			Skip to content
		</a>
		<slot />
	</body>
</html>
