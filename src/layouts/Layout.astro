---
import { PageMetadata } from "@/src/components/hybrid-astro-ui/page-metadata";
import OGImage from "@/src/assets/background.png"

interface Props {
	title: string;
	description: string;
	locale: string;
	alternateLinks?: { href: string; hreflang: string }[];
	ogType?: 'website' | 'article';
	schema?: Record<string, unknown>;
}

const { title, description, locale, alternateLinks, ogType = 'website', schema } =
	Astro.props as Props;
---

<!doctype html>
<html lang={locale}>
	<head>
		<!-- Blocking theme script: must run before render to avoid flash -->
		<script is:inline>
			(function() {
				var stored = localStorage.getItem('theme');
				var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				var isDark = stored === 'light' ? false : stored === 'dark' ? true : prefersDark !== undefined ? prefersDark : true;
				if (isDark) document.documentElement.classList.add('dark');
			})();
		</script>

		<PageMetadata
			lang={locale}
			title={title}
			description={description}
			image={OGImage}
			enableClientRouter
			ogType={ogType}
			favicons={[
				{ rel: "icon", type: "image/svg+xml", href: "/favicon.svg" },
				{ rel: "apple-touch-icon", type: "image/png", href: "/favicon.png" },
				{ rel: "manifest", href: "/site.webmanifest" },
			]}
			alternateLinks={alternateLinks}
		/>
		<!-- Schema.org structured data -->
		<script is:inline type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "Person",
				"name": "Andrei",
				"url": "https://andreirepo.com",
				"jobTitle": "Senior QA Engineer",
				"description": "Senior QA Engineer specializing in highly regulated iGaming",
				"sameAs": [
					"https://github.com/andreirepo",
					"https://linkedin.com/in/andreirepo"
				],
				"knowsAbout": [
					"QA Engineering",
					"Test Automation",
					"Playwright",
					"Cypress",
					"iGaming",
					"AWS",
					"Docker"
				]
			}
		</script>
		{schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}
		<!-- Umami Analytics -->
		<script defer src="https://analytics.andreirepo.com/script.js" data-website-id="6f047764-b516-4fa2-a909-fe4fa0ac5d48"></script>
	</head>
	<body class="flex flex-col items-center w-full font-sans leading-relaxed overflow-x-hidden">
		<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:bg-amber-accent-bg focus:text-white focus:px-4 focus:py-2 focus:rounded focus:z-50">
			Skip to content
		</a>
		<div class="w-full max-w-2xl px-5 md:px-0 flex flex-col">
			<slot />
		</div>
		<!-- Scroll to top button — fixed overlay, intentionally outside constrained wrapper -->
		<button
			id="scroll-top"
			aria-label="Scroll to top"
			class="fixed bottom-5 right-3 sm:bottom-6 sm:right-4 w-9 h-9 flex items-center justify-center rounded border border-amber-accent/50 text-amber-accent bg-amber-accent/10 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300 hover:bg-amber-accent hover:text-white hover:border-amber-accent active:scale-95 text-base z-50"
		>
			↑
		</button>
		<script>
			const btn = document.getElementById('scroll-top');
			if (btn) {
				window.addEventListener('scroll', () => {
					const show = window.scrollY > 300;
					btn.classList.toggle('opacity-70', show);
					btn.classList.toggle('opacity-0', !show);
					btn.classList.toggle('pointer-events-none', !show);
				});
				btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
			}
		</script>
		<script>
			// Section scroll-triggered fade-in
			function initSectionAnimations() {
				const sections = document.querySelectorAll('.section-fade-in');
				if (!sections.length) return;
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								observer.unobserve(entry.target);
							}
						});
					},
					{ threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
				);
				sections.forEach((el) => observer.observe(el));
			}
			initSectionAnimations();
			document.addEventListener('astro:after-swap', initSectionAnimations);

			// Dynamic copyright year
			const yearEl = document.getElementById('copyright-year');
			if (yearEl) yearEl.textContent = String(new Date().getFullYear());
		</script>
	</body>
</html>
