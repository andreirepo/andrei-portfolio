---
import { PageMetadata } from "@/src/components/hybrid-astro-ui/page-metadata";
import OGImage from "@/src/assets/og-card.png"

interface Props {
	title: string;
	description: string;
	locale: string;
	alternateLinks?: { href: string; hreflang: string }[];
	ogType?: 'website' | 'article';
	robots?: string;
	schema?: Record<string, unknown>;
}

const { title, description, locale, alternateLinks, ogType = 'website', robots, schema } =
	Astro.props as Props;

const SITE = Astro.site ?? new URL("https://andreirepo.com/");

/**
 * One Person node, referenced from every page by @id, plus the WebSite it
 * belongs to. Pages add their own node (ProfilePage, BlogPosting) and point
 * at these rather than restating them — duplicated, divergent Person copies
 * are how a crawler ends up with three different jobs for the same person.
 */
const PERSON_ID = new URL("/#person", SITE).href;

const person = {
	"@type": "Person",
	"@id": PERSON_ID,
	name: "Andrei Repo",
	url: SITE.href,
	image: new URL(OGImage.src, SITE).href,
	jobTitle: "Senior QA Engineer",
	description,
	email: "contact@andreirepo.com",
	sameAs: ["https://github.com/andreirepo", "https://linkedin.com/in/andreirepo"],
	knowsAbout: [
		"QA Engineering",
		"Test Automation",
		"Playwright",
		"Cypress",
		"WebdriverIO",
		"iGaming",
		"AWS",
		"Docker",
		"GitHub Actions",
	],
	knowsLanguage: ["en", "es"],
	address: { "@type": "PostalAddress", addressCountry: "ES" },
	worksFor: { "@type": "Organization", name: "Open Assessment Technologies" },
	hasOccupation: {
		"@type": "Occupation",
		name: "QA Automation Engineer",
		skills: "Playwright, Cypress, WebdriverIO, GitHub Actions, Docker, AWS",
	},
	seeks: { "@type": "Demand", name: "Senior or lead QA Engineer roles" },
};

const website = {
	"@type": "WebSite",
	"@id": new URL("/#website", SITE).href,
	url: SITE.href,
	name: "Andrei Repo",
	description,
	inLanguage: "en",
	publisher: { "@id": PERSON_ID },
};

/**
 * Cloudflare's Scrape Shield rewrites anything that looks like an address
 * inside the HTML, including inside this script — and rewriting it injects a
 * <span> that turns the JSON into a syntax error. Escaping the @ as \u0040 is
 * still valid JSON (every parser decodes it to "@"), but does not match
 * Cloudflare's pattern, so the node survives intact.
 */
const jsonLd = JSON.stringify({
	"@context": "https://schema.org",
	"@graph": [person, website],
}).replace('"contact@andreirepo.com"', '"contact\\u0040andreirepo.com"');

// Page-level nodes (ProfilePage, BlogPosting) inherit the shared social card
// unless they bring their own, so no page ships an image-less article.
const pageSchema = schema
	? { ...schema, image: schema.image ?? new URL(OGImage.src, SITE).href }
	: null;
---

<!doctype html>
<html lang={locale}>
	<head>
		<!-- Blocking theme script: must run before render to avoid flash -->
		<script is:inline>
			(function() {
				var stored = localStorage.getItem('theme');
				var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				var isDark = stored === 'light' ? false : stored === 'dark' ? true : prefersDark !== undefined ? prefersDark : true;
				if (isDark) document.documentElement.classList.add('dark');
			})();
		</script>

		<PageMetadata
			lang={locale}
			title={title}
			description={description}
			image={OGImage}
			imageAlt="Andrei Repo — Senior QA Engineer, open to senior and lead QA roles"
			enableClientRouter
			ogType={ogType}
			robots={robots}
			favicons={[
				{ rel: "icon", type: "image/svg+xml", href: "/favicon.svg" },
				{ rel: "apple-touch-icon", type: "image/png", href: "/favicon.png" },
				{ rel: "manifest", href: "/site.webmanifest" },
			]}
			alternateLinks={alternateLinks}
		/>
		<!-- Schema.org: Person + WebSite, referenced by @id from each page -->
		<script is:inline type="application/ld+json" set:html={jsonLd} />
		{pageSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(pageSchema)} />}
		<!-- Umami Analytics -->
		<script defer src="https://analytics.andreirepo.com/script.js" data-website-id="6f047764-b516-4fa2-a909-fe4fa0ac5d48"></script>
	</head>
	<body class="flex flex-col items-center w-full font-sans leading-relaxed overflow-x-hidden">
		<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:bg-amber-accent-bg focus:text-white focus:px-4 focus:py-2 focus:rounded focus:z-50">
			Skip to content
		</a>
		<div class="w-full max-w-3xl px-5 md:px-0 flex flex-col">
			<slot />
		</div>
		<!-- Scroll to top button — fixed overlay, intentionally outside constrained wrapper -->
		<button
			id="scroll-top"
			aria-label="Scroll to top"
			class="fixed bottom-5 right-4 w-9 h-9 flex items-center justify-center rounded border border-amber-accent/50 text-amber-text bg-amber-accent/10 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300 hover:bg-amber-accent-bg hover:text-white hover:border-amber-accent active:scale-95 text-base z-50"
			style="bottom: max(1.25rem, env(safe-area-inset-bottom, 1.25rem));"
		>
			↑
		</button>
		<script>
			const btn = document.getElementById('scroll-top');
			if (btn) {
				window.addEventListener('scroll', () => {
					const show = window.scrollY > 300;
					btn.classList.toggle('opacity-70', show);
					btn.classList.toggle('opacity-0', !show);
					btn.classList.toggle('pointer-events-none', !show);
				});
				btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
			}
		</script>
		<script>
			// Dynamic copyright year
			const yearEl = document.getElementById('copyright-year');
			if (yearEl) yearEl.textContent = String(new Date().getFullYear());
		</script>
	</body>
</html>
