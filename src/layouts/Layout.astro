---
import { PageMetadata } from "@/src/components/hybrid-astro-ui/page-metadata";
import OGImage from "@/src/assets/background.png"

interface Props {
	title: string;
	description: string;
	locale: string;
	alternateLinks?: { href: string; hreflang: string }[];
}

const { title, description, locale, alternateLinks } =
	Astro.props as Props;
---

<!doctype html>
<html lang={locale}>
	<head>
		<!-- Blocking theme script: must run before render to avoid flash -->
		<script is:inline>
			(function() {
				var stored = localStorage.getItem('theme');
				var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				var isDark = stored === 'light' ? false : stored === 'dark' ? true : prefersDark !== undefined ? prefersDark : true;
				if (isDark) document.documentElement.classList.add('dark');
			})();
		</script>
		<PageMetadata
			lang={locale}
			title={title}
			description={description}
			image={OGImage}
			enableClientRouter
			ogType="website"
			favicons={[  { rel: "icon", type: "image/svg+xml", href: "/favicon.svg" },]}
			alternateLinks={alternateLinks}
		/>
	</head>
	<body class="*:max-w-2xl *:w-full flex flex-col items-center w-full font-mono px-5 md:px-0 leading-10" >
		<slot />
	</body>
</html>
